# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-iife/
dist-app/
build/
*.tsbuildinfo

# Generated review artifacts (regenerate via each package's own generator script)
packages/spanish-deck-ui/sample/

# Test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Vitest Browser Mode failure attachments (actual/diff screenshots on a
# toMatchScreenshot mismatch) — transient debugging artifacts, never the
# reviewable baseline itself. Baselines live in each test's own
# __screenshots__/ directory, which IS committed.
.vitest-attachments/

# Environment
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tooling state
.atl/
.codegraph/
.turbo/
.cache/
.playwright-mcp/

# E2E harness runtime handoff (written by e2e/global-setup.ts, read by the
# e2e test files — see vitest.e2e.config.ts)
e2e/.harness/

# Redis integration harness runtime handoff (written by
# redis-tests/global-setup.ts — see vitest.redis.config.ts)
redis-tests/.harness/

# Capturas de trabajo en la raiz: artefactos de depuracion, nunca del repo.
/*.png
